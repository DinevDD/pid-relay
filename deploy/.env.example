# --- front proxy -----------------------------------------------------------
PIDRELAY_HOST=fair-testbed.eemcs.utwente.nl
ACME_EMAIL=you@utwente.nl

# --- redirector + UI ----------------------------------------------------------
PIDRELAY_PUBLIC_URL=https://fair-testbed.eemcs.utwente.nl

# Rules repository the server deploys from (branch is checked every SYNC_INTERVAL s)
PIDRELAY_REMOTE=https://github.com/luizbonino/pid-relay.git
PIDRELAY_BRANCH=main
PIDRELAY_SYNC_INTERVAL=60

# GitHub mode: the UI opens pull requests with this token (fine-grained token of
# the account named as ui_bot in config/platform.yaml; repository permissions
# Contents: read/write and Pull requests: read/write). Leave both empty to make
# the UI push directly to PIDRELAY_BRANCH instead.
PIDRELAY_GITHUB_REPO=luizbonino/pid-relay
PIDRELAY_GITHUB_TOKEN=

# Optional: initial password of the 'admin' account. If empty, a random one is
# printed once in the logs (docker compose logs ui).
PIDRELAY_ADMIN_PASSWORD=
