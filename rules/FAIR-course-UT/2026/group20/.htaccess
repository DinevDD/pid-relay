# Worked example: https://w3id.org/FAIR-course-UT/2026/group20/...
RewriteEngine on

# Dataset descriptions: RDF for machines, HTML for people (content negotiation).
RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^dataset/([a-z0-9-]+)$ https://example.org/group20/datasets/$1.ttl [R=303,L]

RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^dataset/([a-z0-9-]+)$ https://example.org/group20/datasets/$1.jsonld [R=303,L]

RewriteRule ^dataset/([a-z0-9-]+)$ https://example.org/group20/datasets/$1.html [R=303,L]

# Vocabulary terms all resolve to the ontology document.
RewriteRule ^vocab(/.*)?$ https://example.org/group20/vocab.ttl [R=303,L]

# Anything else: the group's landing page.
RewriteRule ^$ https://example.org/group20/ [R=302,L]
